<Window x:Class="EtherealBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtherealBar"
        Title="EtherealBar"
        Height="500"
        Width="1920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="UIWindow"
        Focusable="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <local:TileWidthConverter x:Key="TileWidthConverter"/>
        <local:MediaOffsetConverter x:Key="MediaOffsetConverter"/>
        <local:MediaDimensionConverter x:Key="MediaDimensionConverter"/>

        <Style x:Key="EditControlStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="TileEditActionButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#33000000"/>
        </Style>

        <Style x:Key="EditDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#CCB42318"/>
            <Setter Property="BorderBrush" Value="#FF7A3A3A"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF2A2A"/>
                    <Setter Property="BorderBrush" Value="#FFB00020"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TileWidthConverter}">
                        <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="AspectRatio"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Height">
                <Setter.Value>
                    <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="mainBorder"
                                    Background="#45000000"
                                    BorderThickness="2"
                                    BorderBrush="#30FFFFFF"
                                    CornerRadius="20"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HoverScale"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="MediaViewport"
                                            CornerRadius="20"
                                            SnapsToDevicePixels="True"
                                            SizeChanged="TileContentBorder_SizeChanged">
                                        <Grid>
                                            <MediaElement x:Name="bgVideo"
                                                          Source="{Binding Path}"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Manual"
                                                          IsMuted="True"
                                                          Stretch="Fill"
                                                          ScrubbingEnabled="False"
                                                          Visibility="{Binding IsVideoVisible}"
                                                          MediaOpened="bgVideo_MediaOpened"
                                                          MediaEnded="bgVideo_MediaEnded"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                <MediaElement.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Width>
                                                <MediaElement.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Height>
                                                <MediaElement.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </MediaElement.RenderTransform>
                                            </MediaElement>
                                            <Image Source="{Binding Path}"
                                                   Stretch="Fill"
                                                   Visibility="{Binding IsImageVisible}"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Image.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Width>
                                                <Image.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Height>
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Border Background="#20000000"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,20">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditControlStyle}"
                                                 Background="#EE000000"
                                                 Foreground="White"
                                                 Margin="0,6"
                                                 Height="40"
                                                 MinHeight="40"
                                                 Padding="10,6"
                                                 FontSize="16"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"/>
                                        <StackPanel Style="{StaticResource EditControlStyle}" Margin="0,4,0,0">
                                            <DockPanel>
                                                <TextBlock Text="Р¤РѕСЂРјР°С‚ РєР°СЂС‚РѕС‡РєРё" Foreground="White" Opacity="0.55" FontSize="11"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AspectRatio, StringFormat={}{0:0.00}}"
                                                           Foreground="White" Opacity="0.55" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0.5625"
                                                    Maximum="1.77777777777778"
                                                    Value="{Binding AspectRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    IsMoveToPointEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource EditControlStyle}">
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupMedia_Click" Tag="{Binding}" Content="рџ–ј"/>
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="CropMedia_Click" Tag="{Binding}" Content="вњҐ"/>
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupApp_Click" Tag="{Binding}" Content="рџљЂ"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,-5,-5,0"
                                    Content="вњ•"
                                    Style="{StaticResource EditDeleteButtonStyle}"
                                    Click="DeleteButton_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="mainBorder" Property="Opacity" Value="0.5"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="mainBorder" Property="Background" Value="#66000000"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </MultiDataTrigger.Setters>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Bottom" Background="Transparent">
        <StackPanel x:Name="FullPanelContainer" VerticalAlignment="Bottom">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" Y="450"/>
            </StackPanel.RenderTransform>

            <Border x:Name="MainPanel"
                    Background="Transparent"
                    Height="{Binding WidgetHeight}"
                    BorderThickness="0"
                    Padding="0">
                <Grid>
                    <Border Background="{Binding PanelBackgroundBrush}"
                            BorderThickness="0"/>

                    <Grid Margin="0">
                        <ScrollViewer x:Name="MainScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                                <ItemsControl x:Name="MediaHost" ItemsSource="{Binding Buttons}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TileButtonStyle}"
                                                    Click="Tile_Click"
                                                    AllowDrop="True"
                                                    PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="Tile_PreviewMouseMove"
                                                    Drop="Tile_Drop"
                                                    DragOver="Tile_DragOver"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+"
                                        Width="60"
                                        Height="{Binding TileHeight}"
                                        Click="AddButton_Click"
                                        Margin="10,0"
                                        FontSize="30"
                                        Style="{StaticResource RoundedButtonStyle}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12,-40,12,0"
                                    Panel.ZIndex="20">
                            <Button Content="вњЋ"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="ToggleEditMode_Click"/>
                            <Button Content="вљ™"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OpenSettings_Click"/>
                            <Button Content="вњ•"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="0"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>

