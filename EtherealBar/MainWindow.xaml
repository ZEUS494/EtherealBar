<Window x:Class="EtherealBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtherealBar"
        Title="EtherealBar"
        Height="500"
        Width="1920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="UIWindow"
        Focusable="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <local:TileWidthConverter x:Key="TileWidthConverter"/>
        <local:MediaOffsetConverter x:Key="MediaOffsetConverter"/>
        <local:MediaDimensionConverter x:Key="MediaDimensionConverter"/>
        <local:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter"/>
        <local:AccentOpacityBrushConverter x:Key="AccentOpacityBrushConverter"/>
        <local:TextPositionConverter x:Key="TextPositionConverter"/>
        <local:FontSizeConverter x:Key="FontSizeConverter"/>

        <Style x:Key="EditControlStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2AFFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="TileEditActionButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="5,8,5,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#44000000"/>
        </Style>

        <Style x:Key="WorkspaceTabBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="SelectedWorkspace"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#2AFFFFFF"/>
                    <Setter Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                    <Setter Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#CCFF3B30"/>
            <Setter Property="BorderBrush" Value="#44FF3B30"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF453A"/>
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter Property="Background" Value="#33000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButtonBaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                Height="6"
                                VerticalAlignment="Center"
                                CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButtonBaseStyle}">
            <Setter Property="Background" Value="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    CornerRadius="3">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.3"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="24" Height="24">
                            <Ellipse x:Name="OuterCircle"
                                     Fill="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Width="24" Height="24">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="Black" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="InnerCircle"
                                     Fill="White"
                                     Width="12" Height="12"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="White"/>
                                <Setter TargetName="OuterCircle" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32"
                              VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderDecreaseRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonBaseStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TileWidthConverter}">
                        <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="AspectRatio"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Height">
                <Setter.Value>
                    <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="mainBorder"
                                    Background="#45000000"
                                    BorderBrush="#30FFFFFF"
                                    CornerRadius="20"
                                    ClipToBounds="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowTileBorder, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="HoverScale"/>
                                        <TranslateTransform X="{Binding DragOffsetX}"
                                                            Y="{Binding DragOffsetY}"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="MediaViewport"
                                            Background="Transparent"
                                            CornerRadius="20"
                                            SnapsToDevicePixels="True"
                                            SizeChanged="TileContentBorder_SizeChanged">
                                        <Grid>
                                            <MediaElement x:Name="bgVideo"
                                                          Source="{Binding Path}"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Manual"
                                                          IsMuted="True"
                                                          Stretch="Fill"
                                                          ScrubbingEnabled="False"
                                                          Visibility="{Binding IsVideoVisible}"
                                                          MediaOpened="bgVideo_MediaOpened"
                                                          MediaEnded="bgVideo_MediaEnded"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                    RenderOptions.BitmapScalingMode="HighQuality">
                                                <MediaElement.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Width>
                                                <MediaElement.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Height>
                                                <MediaElement.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </MediaElement.RenderTransform>
                                            </MediaElement>
                                            <local:AnimatedGifImage SourcePath="{Binding Path}"
                                                                    Stretch="Fill"
                                                                    Visibility="{Binding IsGifVisible}"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    RenderOptions.BitmapScalingMode="HighQuality">
                                                <local:AnimatedGifImage.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </local:AnimatedGifImage.Width>
                                                <local:AnimatedGifImage.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </local:AnimatedGifImage.Height>
                                                <local:AnimatedGifImage.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </local:AnimatedGifImage.RenderTransform>
                                            </local:AnimatedGifImage>

                                            <Image Source="{Binding Path}"
                                                   Stretch="Fill"
                                                   Visibility="{Binding IsStaticImageVisible}"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Width>
                                                <Image.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Height>
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Border x:Name="PngOverlay" Background="Transparent"/>
                                        </Grid>
                                    </Border>
                                    <Grid x:Name="InfoPanel" Margin="10,0">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{Binding DataContext.TitleForegroundBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontFamily="{Binding DataContext.TitleFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.FontSize>
                                                <MultiBinding Converter="{StaticResource FontSizeConverter}">
                                                    <Binding Path="DataContext.TitleFontSizeScale" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.FontSize>
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform>
                                                    <TranslateTransform.Y>
                                                        <MultiBinding Converter="{StaticResource TextPositionConverter}">
                                                            <Binding Path="DataContext.TitleVerticalOffset" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </TranslateTransform.Y>
                                                </TranslateTransform>
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.7" RenderingBias="Performance"/>
                                            </TextBlock.Effect>
                                        </TextBlock>

                                        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,10">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource EditControlStyle}"
                                                     Background="#EE000000"
                                                     Foreground="White"
                                                     Margin="0,6"
                                                     Height="40"
                                                     MinHeight="40"
                                                     Padding="10,6"
                                                     FontSize="16"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"/>
                                            <StackPanel Style="{StaticResource EditControlStyle}" Margin="0,4,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="Формат карточки" Foreground="White" Opacity="0.55" FontSize="11"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding AspectRatio, StringFormat={}{0:0.00}}"
                                                               Foreground="White" Opacity="0.55" FontSize="11"/>
                                                </DockPanel>
                                                <Slider Minimum="0.5625"
                                                        Maximum="1.77777777777778"
                                                        Value="{Binding AspectRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True"
                                                        IsMoveToPointEnabled="True"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource EditControlStyle}">
                                                <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupMedia_Click" Tag="{Binding}" Content="🖼"/>
                                                <Button Style="{StaticResource TileEditActionButtonStyle}" Click="CropMedia_Click" Tag="{Binding}" Content="✥"/>
                                                <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupApp_Click" Tag="{Binding}" Content="🚀"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Button VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,-5,-5,0"
                                    Content="✕"
                                    Click="DeleteButton_Click"
                                    Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditDeleteButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPng}" Value="True"/>
                                    <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="mainBorder" Property="Background" Value="#22000000"/>
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="#30FFFFFF"/>
                                <Setter TargetName="PngOverlay" Property="Background" Value="#20000000"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsPng}" Value="True">
                                <Setter TargetName="mainBorder" Property="Background" Value="Transparent"/>
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="PngOverlay" Property="Background" Value="Transparent"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="mainBorder" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="mainBorder" Property="Panel.ZIndex" Value="50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="mainBorder" Property="Background" Value="#66000000"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                    <Condition Binding="{Binding DataContext.ShowTileBorder, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </MultiDataTrigger.Setters>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                    <Condition Binding="{Binding DataContext.ShowTileBorder, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Stretch" Background="Transparent">
        <Grid x:Name="FullPanelContainer">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PanelDock}" Value="Top">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" Y="450"/>
            </Grid.RenderTransform>

            <Grid VerticalAlignment="Stretch">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PanelDock}" Value="Top">
                                <Setter Property="VerticalAlignment" Value="Top"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Tabs/Buttons when Docked Bottom -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Panel Background & Cards -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: Tabs/Buttons when Docked Top -->
                </Grid.RowDefinitions>

                <!-- Panel Background (Always Row 1) -->
                <Border Grid.Row="1"
                        x:Name="MainPanel"
                        Background="{Binding PanelBackgroundBrush}"
                        Height="{Binding WidgetHeight}"
                        BorderThickness="0"
                        SnapsToDevicePixels="True">
                </Border>

                <!-- Cards (Always Row 1, sits on background) -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MainScrollViewer"
                              Height="{Binding WidgetHeight}"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Grid VerticalAlignment="Center" Margin="8,0,8,0">
                        <ItemsControl ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="WorkspacePanel">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                                                <Binding/>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="SelectedWorkspace"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding Buttons}"
                                                          Loaded="WorkspaceMediaHost_Loaded"
                                                          Unloaded="WorkspaceMediaHost_Unloaded"
                                                          VirtualizingPanel.IsVirtualizing="True"
                                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Horizontal" VirtualizationMode="Recycling"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource TileButtonStyle}"
                                                                Click="Tile_Click"
                                                                PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                                                PreviewMouseMove="Tile_PreviewMouseMove"
                                                                PreviewMouseLeftButtonUp="Tile_PreviewMouseLeftButtonUp"
                                                                LostMouseCapture="Tile_LostMouseCapture"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Content="+"
                                                    Width="60"
                                                    Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Click="AddButton_Click"
                                                    Margin="10,0"
                                                    FontSize="30">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Workspace Tabs (Left side) -->
                <ScrollViewer x:Name="WorkspaceTabsScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="12,0,160,8"
                              Panel.ZIndex="20"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Left"
                              PanningMode="HorizontalOnly">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Margin" Value="12,0,160,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PanelDock}" Value="Top">
                                    <Setter Property="Grid.Row" Value="2"/>
                                    <Setter Property="Margin" Value="12,8,160,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="WorkspacesTabsItems" ItemsSource="{Binding Workspaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Tag="{Binding}"
                                            Style="{StaticResource WorkspaceTabBorderStyle}"
                                            MouseLeftButtonUp="WorkspaceTab_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     MinWidth="90"
                                                     MaxWidth="170"
                                                     MaxLength="24"
                                                     Background="Transparent"
                                                     Foreground="White"
                                                     BorderThickness="0"
                                                     Padding="0"
                                                     TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     GotFocus="WorkspaceName_GotFocus"
                                                     LostFocus="WorkspaceName_LostFocus"
                                                     PreviewKeyDown="WorkspaceName_PreviewKeyDown">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <Button Content="✎"
                                                        Width="18"
                                                        Height="18"
                                                        FontSize="11"
                                                        Padding="0"
                                                        Margin="0,-2,6,0"
                                                        Tag="{Binding}"
                                                        Background="#4FFFFFFF"
                                                        Style="{StaticResource RoundedButtonStyle}"
                                                        Click="WorkspaceRenameButton_Click"/>

                                                <Button Content="✕"
                                                        Width="18"
                                                        Height="18"
                                                        FontSize="11"
                                                        Padding="0"
                                                        Margin="0,-2,0,0"
                                                        Tag="{Binding}"
                                                        Background="#4FFF3B30"
                                                        Style="{StaticResource RoundedButtonStyle}"
                                                        Click="WorkspaceClose_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Width="40"
                                Height="36"
                                Margin="8,0,0,0"
                                FontSize="20"
                                Content="+"
                                Click="AddWorkspace_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Control Buttons (Right side) -->
                <StackPanel x:Name="ControlButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,20,8"
                            Panel.ZIndex="100"
                            VerticalAlignment="Bottom">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Margin" Value="0,0,20,8"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PanelDock}" Value="Top">
                                    <Setter Property="Grid.Row" Value="2"/>
                                    <Setter Property="Margin" Value="0,8,20,0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    
                    <Button Content="✎"
                            Style="{StaticResource IconButtonStyle}"
                            Click="EditMode_Click">
                        <Button.ToolTip>
                            <ToolTip Content="Режим редактирования"/>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="⚙"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Settings_Click"/>
                    <Button Content="✕"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Exit_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
