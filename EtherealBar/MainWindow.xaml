<Window x:Class="EtherealBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtherealBar"
        Title="EtherealBar"
        Height="500"
        Width="1920"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        x:Name="UIWindow"
        Focusable="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <local:TileWidthConverter x:Key="TileWidthConverter"/>
        <local:MediaOffsetConverter x:Key="MediaOffsetConverter"/>
        <local:MediaDimensionConverter x:Key="MediaDimensionConverter"/>
        <local:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter"/>

        <Style x:Key="EditControlStyle" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                                </ObjectAnimationUsingKeyFrames>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                    <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                                </ObjectAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="TileEditActionButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,8,4,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#33000000"/>
        </Style>

        <Style x:Key="WorkspaceTabButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2CFFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <DataTrigger Value="True">
                                <DataTrigger.Binding>
                                    <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Tag"/>
                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="SelectedWorkspace"/>
                                    </MultiBinding>
                                </DataTrigger.Binding>
                                <Setter TargetName="TabBorder" Property="Background" Value="#34FFFFFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#CCB42318"/>
            <Setter Property="BorderBrush" Value="#FF7A3A3A"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFFF2A2A"/>
                    <Setter Property="BorderBrush" Value="#FFB00020"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SliderTrackButtonBaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#B8B8B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                Height="2"
                                VerticalAlignment="Center"
                                CornerRadius="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButtonBaseStyle}">
            <Setter Property="Background" Value="#4A67D6"/>
        </Style>

        <Style x:Key="SliderIncreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButtonBaseStyle}">
            <Setter Property="Background" Value="#B8B8B8"/>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="14" Height="14">
                            <Ellipse x:Name="AccentRing"
                                     Width="14"
                                     Height="14"
                                     Fill="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Opacity="1"/>
                            <Ellipse x:Name="InnerCircle"
                                     Width="10"
                                     Height="10"
                                     Fill="#FFFFFFFF"
                                     StrokeThickness="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerCircle" Property="Fill" Value="#F4F6FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="InnerCircle" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20"
                              VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource SliderDecreaseRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderIncreaseRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource TileWidthConverter}">
                        <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="AspectRatio"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Height">
                <Setter.Value>
                    <Binding Path="TileHeight" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="mainBorder"
                                    Background="#45000000"
                                    BorderThickness="2"
                                    BorderBrush="#30FFFFFF"
                                    CornerRadius="20"
                                    ClipToBounds="True"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="HoverScale"/>
                                        <TranslateTransform X="{Binding DragOffsetX}"
                                                            Y="{Binding DragOffsetY}"/>
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="MediaViewport"
                                            CornerRadius="20"
                                            SnapsToDevicePixels="True"
                                            SizeChanged="TileContentBorder_SizeChanged">
                                        <Grid>
                                            <MediaElement x:Name="bgVideo"
                                                          Source="{Binding Path}"
                                                          LoadedBehavior="Manual"
                                                          UnloadedBehavior="Manual"
                                                          IsMuted="True"
                                                          Stretch="Fill"
                                                          ScrubbingEnabled="False"
                                                          Visibility="{Binding IsVideoVisible}"
                                                          MediaOpened="bgVideo_MediaOpened"
                                                          MediaEnded="bgVideo_MediaEnded"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                <MediaElement.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Width>
                                                <MediaElement.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </MediaElement.Height>
                                                <MediaElement.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </MediaElement.RenderTransform>
                                            </MediaElement>
                                            <local:AnimatedGifImage SourcePath="{Binding Path}"
                                                                    Stretch="Fill"
                                                                    Visibility="{Binding IsGifVisible}"
                                                                    RenderTransformOrigin="0.5,0.5"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                <local:AnimatedGifImage.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </local:AnimatedGifImage.Width>
                                                <local:AnimatedGifImage.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </local:AnimatedGifImage.Height>
                                                <local:AnimatedGifImage.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </local:AnimatedGifImage.RenderTransform>
                                            </local:AnimatedGifImage>

                                            <Image Source="{Binding Path}"
                                                   Stretch="Fill"
                                                   Visibility="{Binding IsStaticImageVisible}"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Image.Width>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Width">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Width>
                                                <Image.Height>
                                                    <MultiBinding Converter="{StaticResource MediaDimensionConverter}" ConverterParameter="Height">
                                                        <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                        <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                        <Binding Path="SourceAspectRatio"/>
                                                    </MultiBinding>
                                                </Image.Height>
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding MediaScale}" ScaleY="{Binding MediaScale}"/>
                                                        <TranslateTransform>
                                                            <TranslateTransform.X>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="X">
                                                                    <Binding Path="MediaOffsetX"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.X>
                                                            <TranslateTransform.Y>
                                                                <MultiBinding Converter="{StaticResource MediaOffsetConverter}" ConverterParameter="Y">
                                                                    <Binding Path="MediaOffsetY"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualWidth"/>
                                                                    <Binding ElementName="MediaViewport" Path="ActualHeight"/>
                                                                    <Binding Path="MediaScale"/>
                                                                    <Binding Path="SourceAspectRatio"/>
                                                                </MultiBinding>
                                                            </TranslateTransform.Y>
                                                        </TranslateTransform>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                            <Border Background="#20000000"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,20">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="5" ShadowDepth="2"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource EditControlStyle}"
                                                 Background="#EE000000"
                                                 Foreground="White"
                                                 Margin="0,6"
                                                 Height="40"
                                                 MinHeight="40"
                                                 Padding="10,6"
                                                 FontSize="16"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"/>
                                        <StackPanel Style="{StaticResource EditControlStyle}" Margin="0,4,0,0">
                                            <DockPanel>
                                                <TextBlock Text="Формат карточки" Foreground="White" Opacity="0.55" FontSize="11"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding AspectRatio, StringFormat={}{0:0.00}}"
                                                           Foreground="White" Opacity="0.55" FontSize="11"/>
                                            </DockPanel>
                                            <Slider Minimum="0.5625"
                                                    Maximum="1.77777777777778"
                                                    Value="{Binding AspectRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    IsMoveToPointEnabled="True"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource EditControlStyle}">
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupMedia_Click" Tag="{Binding}" Content="🖼"/>
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="CropMedia_Click" Tag="{Binding}" Content="✥"/>
                                            <Button Style="{StaticResource TileEditActionButtonStyle}" Click="SetupApp_Click" Tag="{Binding}" Content="🚀"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button VerticalAlignment="Top"
                                    HorizontalAlignment="Right"
                                    Margin="0,-5,-5,0"
                                    Content="✕"
                                    Click="DeleteButton_Click"
                                    Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource EditDeleteButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                <Setter TargetName="mainBorder" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="mainBorder" Property="Panel.ZIndex" Value="50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter TargetName="mainBorder" Property="Background" Value="#66000000"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.Setters>
                                    <Setter TargetName="mainBorder" Property="BorderBrush" Value="{Binding GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </MultiDataTrigger.Setters>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid VerticalAlignment="Bottom" Background="Transparent">
        <StackPanel x:Name="FullPanelContainer" VerticalAlignment="Bottom">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="PanelTransform" Y="450"/>
            </StackPanel.RenderTransform>

            <Border x:Name="MainPanel"
                    Background="Transparent"
                    Height="{Binding WidgetHeight}"
                    BorderThickness="0"
                    Padding="0"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Border Background="{Binding PanelBackgroundBrush}"
                            BorderThickness="0"
                            SnapsToDevicePixels="True"
                            ClipToBounds="True"/>

                    <Grid Margin="0">
                        <ScrollViewer x:Name="MainScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                            <Grid VerticalAlignment="Center" Margin="8,0,8,0">
                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="WorkspacePanel">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
                                                                        <Binding/>
                                                                        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="SelectedWorkspace"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding Buttons}"
                                                                  Loaded="WorkspaceMediaHost_Loaded"
                                                                  Unloaded="WorkspaceMediaHost_Unloaded">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource TileButtonStyle}"
                                                                        Click="Tile_Click"
                                                                        PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="Tile_PreviewMouseMove"
                                                                        PreviewMouseLeftButtonUp="Tile_PreviewMouseLeftButtonUp"
                                                                        LostMouseCapture="Tile_LostMouseCapture"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Content="+"
                                                            Width="60"
                                                            Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Click="AddButton_Click"
                                                            Margin="10,0"
                                                            FontSize="30">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="12,-40,160,0"
                                      Panel.ZIndex="20"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left"
                                      PanningMode="HorizontalOnly">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl x:Name="WorkspacesTabsItems" ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}"
                                                    Style="{StaticResource WorkspaceTabButtonStyle}"
                                                    Click="WorkspaceTab_Click">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Margin="0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Margin" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Margin" Value="0,0,16,0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"
                                                             Margin="0,0,16,0"
                                                             MinWidth="90"
                                                             MaxWidth="170"
                                                             MaxLength="24"
                                                             Background="Transparent"
                                                             Foreground="White"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             TextAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             GotFocus="WorkspaceName_GotFocus"
                                                             LostFocus="WorkspaceName_LostFocus"
                                                             PreviewKeyDown="WorkspaceName_PreviewKeyDown">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Margin" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Margin" Value="0,0,16,0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>

                                                    <Button Content="✕"
                                                            Width="18"
                                                            Height="18"
                                                            FontSize="11"
                                                            Padding="0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-2,-2,0"
                                                            Tag="{Binding}"
                                                            Background="#AA7A0000"
                                                            Foreground="White"
                                                            BorderBrush="Transparent"
                                                            Cursor="Hand"
                                                            Click="WorkspaceClose_Click"
                                                            PreviewMouseLeftButtonDown="WorkspaceClose_PreviewMouseLeftButtonDown">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="b"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    CornerRadius="9">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="b" Property="Background" Value="#CCB00020"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanDeleteWorkspaces, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="+"
                                        Width="40"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        FontSize="18"
                                        VerticalAlignment="Center"
                                        ToolTip="Добавить вкладку"
                                        Click="AddWorkspace_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanAddWorkspace, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="12,-40,12,0"
                                    Panel.ZIndex="20">
                            <Button Content="✎"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="ToggleEditMode_Click"/>
                            <Button Content="⚙"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="OpenSettings_Click"/>
                            <Button Content="✕"
                                    Style="{StaticResource IconButtonStyle}"
                                    Margin="0"
                                    Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>

