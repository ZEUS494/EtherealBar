<Window x:Class="EtherealBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="РќР°СЃС‚СЂРѕР№РєРё"
        Width="420"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Border Background="#F2181818"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="РќР°СЃС‚СЂРѕР№РєРё"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top"/>

                <Button Grid.Column="1"
                        Content="вњ•"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <CheckBox Margin="0,2,0,0"
                              Content="Р РµР¶РёРј СЂРµРґР°РєС‚РёСЂРѕРІР°РЅРёСЏ"
                              Foreground="White"
                              IsChecked="{Binding IsEditMode, Mode=TwoWay}"/>

                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Р’С‹СЃРѕС‚Р° РІРёРґР¶РµС‚Р°" Foreground="White" Opacity="0.8"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding WidgetHeight, StringFormat={}{0:0}px}"
                                       Foreground="White"
                                       Opacity="0.8"/>
                        </DockPanel>
                        <Slider Minimum="200"
                                Maximum="{Binding MaxWidgetHeight}"
                                Value="{Binding WidgetHeight, Mode=TwoWay}"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                        <TextBlock Text="РњР°РєСЃРёРјСѓРј: РїРѕР»РѕРІРёРЅР° РІС‹СЃРѕС‚С‹ СЌРєСЂР°РЅР°"
                                   Foreground="White"
                                   Opacity="0.45"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Р Р°Р·РјРµСЂ РєР°СЂС‚РѕС‡РµРє" Foreground="White" Opacity="0.8"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding TileScale, StringFormat={}{0:0.00}x}"
                                       Foreground="White"
                                       Opacity="0.8"/>
                        </DockPanel>
                        <Slider Minimum="0.70"
                                Maximum="1.30"
                                Value="{Binding TileScale, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="РџСЂРѕР·СЂР°С‡РЅРѕСЃС‚СЊ С„РѕРЅР° РїР°РЅРµР»Рё" Foreground="White" Opacity="0.8"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding PanelBackgroundOpacity, StringFormat={}{0:0.00}}"
                                       Foreground="White"
                                       Opacity="0.8"/>
                        </DockPanel>
                        <Slider Minimum="0.05"
                                Maximum="1.00"
                                Value="{Binding PanelBackgroundOpacity, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Р¦РІРµС‚ РѕР±РІРѕРґРєРё" Foreground="White" Opacity="0.8"/>
                        <ListBox x:Name="ColorPicker"
                                 Margin="0,8,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="ColorPicker_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="20"
                                            Height="20"
                                            Background="{Binding}"
                                            CornerRadius="10"
                                            Margin="4"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <SolidColorBrush>Cyan</SolidColorBrush>
                            <SolidColorBrush>Lime</SolidColorBrush>
                            <SolidColorBrush>OrangeRed</SolidColorBrush>
                            <SolidColorBrush>Magenta</SolidColorBrush>
                            <SolidColorBrush>Yellow</SolidColorBrush>
                            <SolidColorBrush>White</SolidColorBrush>
                        </ListBox>
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Content="Р’С‹Р±СЂР°С‚СЊ С†РІРµС‚ РѕР±РІРѕРґРєРё..."
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="PickBorderColor_Click"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Р¦РІРµС‚ С„РѕРЅР° РїР°РЅРµР»Рё" Foreground="White" Opacity="0.8"/>
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Content="Р’С‹Р±СЂР°С‚СЊ С†РІРµС‚ С„РѕРЅР°..."
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="PickPanelColor_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="РЎРѕС…СЂР°РЅРёС‚СЊ"
                        Width="120"
                        Height="38"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

