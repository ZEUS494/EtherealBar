<Window x:Class="EtherealBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="500"
        Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="SliderTrackButtonBaseStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="#B8B8B8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                Height="2"
                                VerticalAlignment="Center"
                                CornerRadius="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButtonBaseStyle}">
            <Setter Property="Background" Value="#4A67D6"/>
        </Style>

        <Style x:Key="SliderIncreaseRepeatButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackButtonBaseStyle}">
            <Setter Property="Background" Value="#B8B8B8"/>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="14" Height="14">
                            <Ellipse x:Name="AccentRing"
                                     Width="14"
                                     Height="14"
                                     Fill="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Opacity="1"/>
                            <Ellipse x:Name="InnerCircle"
                                     Width="10"
                                     Height="10"
                                     Fill="#FFFFFFFF"
                                     StrokeThickness="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerCircle" Property="Fill" Value="#F4F6FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="InnerCircle" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Opacity" Value="0.45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="6"
                                CornerRadius="3"
                                Background="#66000000"
                                BorderBrush="#15000000"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#88000000"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#AA000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent"
                              Margin="2,0,0,0">
                            <Border Width="6"
                                    HorizontalAlignment="Center"
                                    Background="#12000000"
                                    CornerRadius="3"/>
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20"
                              VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{Binding DataContext.GlobalBorderBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Style="{StaticResource SliderDecreaseRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderIncreaseRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F2181818"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="-16,-16,-16,0"
                    Padding="16,12,16,12"
                    Background="#CC101114"
                    BorderBrush="#18FFFFFF"
                    BorderThickness="0,0,0,1"
                    CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Настройки"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          CanContentScroll="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <CheckBox Margin="0,2,0,0"
                              Content="Режим редактирования"
                              Foreground="White"
                              IsChecked="{Binding IsEditMode, Mode=TwoWay}"/>

                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Высота виджета" Foreground="White" Opacity="0.8"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding WidgetHeight, StringFormat={}{0:0}px}"
                                       Foreground="White"
                                       Opacity="0.8"/>
                        </DockPanel>
                        <Slider Minimum="{Binding MinWidgetHeight}"
                                Maximum="{Binding MaxWidgetHeight}"
                                Value="{Binding WidgetHeight, Mode=TwoWay}"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                        <TextBlock Text="Максимум: половина высоты экрана"
                                   Foreground="White"
                                   Opacity="0.45"
                                   FontSize="11"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="Прозрачность фона панели" Foreground="White" Opacity="0.8"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding PanelBackgroundOpacity, StringFormat={}{0:0.00}}"
                                       Foreground="White"
                                       Opacity="0.8"/>
                        </DockPanel>
                        <Slider Minimum="0.00"
                                Maximum="1.00"
                                Value="{Binding PanelBackgroundOpacity, Mode=TwoWay}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Положение панели" Foreground="White" Opacity="0.8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Content="Снизу"
                                         Foreground="White"
                                         Margin="0,0,18,0"
                                         IsChecked="{Binding IsDockBottom, Mode=TwoWay}"/>
                            <RadioButton Content="Сверху"
                                         Foreground="White"
                                         IsChecked="{Binding IsDockTop, Mode=TwoWay}"/>
                        </StackPanel>
                        <TextBlock Text="Панель будет выезжать сверху или снизу экрана."
                                   Foreground="White"
                                   Opacity="0.45"
                                   FontSize="11"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Акцентный цвет" Foreground="White" Opacity="0.8"/>
                        <ListBox x:Name="ColorPicker"
                                 Margin="0,8,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="ColorPicker_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="20"
                                            Height="20"
                                            Background="{Binding}"
                                            CornerRadius="10"
                                            Margin="4"
                                            BorderBrush="White"
                                            BorderThickness="1"
                                            Cursor="Hand"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <SolidColorBrush>Cyan</SolidColorBrush>
                            <SolidColorBrush>Lime</SolidColorBrush>
                            <SolidColorBrush>OrangeRed</SolidColorBrush>
                            <SolidColorBrush>Magenta</SolidColorBrush>
                            <SolidColorBrush>Yellow</SolidColorBrush>
                            <SolidColorBrush>White</SolidColorBrush>
                        </ListBox>
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Content="Выбрать акцентный цвет..."
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="PickBorderColor_Click"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Цвет фона панели" Foreground="White" Opacity="0.8"/>
                        <Button Margin="0,8,0,0"
                                Height="34"
                                Content="Выбрать цвет фона..."
                                Style="{StaticResource RoundedButtonStyle}"
                                Click="PickPanelColor_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Сохранить"
                        Width="120"
                        Height="38"
                        Style="{StaticResource RoundedButtonStyle}"
                        Click="Save_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>

