<Window x:Class="EtherealBar.CropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EtherealBar"
        Title="Настройка кадра"
        Width="860"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#101214">

    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Настройка области на карточке"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Перетаскивай медиа мышкой и используй колесо для масштаба."
                       Foreground="#CCFFFFFF"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Border x:Name="EditorFrame"
                    Background="#161A1D"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="18"/>

            <Grid x:Name="EditorSurface"
                  Width="760"
                  Height="430"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  SizeChanged="EditorSurface_SizeChanged"
                  PreviewMouseLeftButtonDown="ViewportBorder_PreviewMouseLeftButtonDown"
                  PreviewMouseLeftButtonUp="ViewportBorder_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="ViewportBorder_PreviewMouseMove"
                  PreviewMouseWheel="ViewportBorder_PreviewMouseWheel">
                <Grid x:Name="MediaViewport"
                      Width="400"
                      Height="400"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      Background="Transparent"
                      SizeChanged="MediaViewport_SizeChanged">
                    <Image x:Name="PreviewImage"
                           Stretch="Fill"
                           Visibility="Collapsed"
                           RenderTransformOrigin="0.5,0.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <MediaElement x:Name="PreviewVideo"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  IsMuted="True"
                                  Stretch="Fill"
                                  Visibility="Collapsed"
                                  MediaOpened="PreviewVideo_MediaOpened"
                                  MediaEnded="PreviewVideo_MediaEnded"
                                  RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    <local:AnimatedGifImage x:Name="PreviewGif"
                                            Stretch="Fill"
                                            Visibility="Collapsed"
                                            RenderTransformOrigin="0.5,0.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="ViewportBorder"
                        Width="400"
                        Height="400"
                        Background="#08000000"
                        BorderBrush="#80FFFFFF"
                        BorderThickness="2"
                        CornerRadius="22"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        SizeChanged="ViewportBorder_SizeChanged"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Масштаб" Foreground="White" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider"
                        Width="220"
                        Margin="12,0,0,0"
                        Minimum="1"
                        Maximum="3"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="False"
                        ValueChanged="ZoomSlider_ValueChanged"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Отмена"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="Cancel_Click"/>

            <Button Grid.Column="2"
                    Content="Сохранить"
                    Width="120"
                    Height="38"
                    Style="{StaticResource RoundedButtonStyle}"
                    Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>

